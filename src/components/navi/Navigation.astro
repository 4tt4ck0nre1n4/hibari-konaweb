---
import { getImage } from "astro:assets";
import HamburgerMenu from "./HamburgerMenu";
import type { HamburgerBrandIcons } from "./HamburgerMenu";
import { line, youtube } from "@/config/ui";
import MenuIcon from "./MenuIcon.astro";
import BackgroundImage from "./BackgroundImage.astro";
import ThemeColor from "./ThemeColor.astro";

const home = {
  classNameHeader: "header__menu_link",
  link: "/",
  ariaLabel: "トップページへ戻る",
  ariaTitle: "トップページへ戻る",
  icon: "flat-color-icons:home",
};
const contact = {
  classNameHeader: "header__menu_link",
  link: "/contact",
  icon: "fluent-emoji-flat:envelope",
  ariaLabel: "お問い合わせページへ",
  ariaTitle: "お問い合わせページへ",
};

// LINE / YouTube 公式ロゴ（PNG）を表示サイズに合わせて最適化し、ハンバーガーメニュー（React）へ渡す。
// 色の変化を避けるため PNG のまま出力する。
const brandImageOptions = { width: 28, densities: [1, 2, 3], format: "png" as const };
const [lineImage, youtubeImage] = await Promise.all([
  getImage({ src: line.image, ...brandImageOptions }),
  getImage({ src: youtube.image, ...brandImageOptions }),
]);
const brandIcons: HamburgerBrandIcons = {
  line: { src: lineImage.src, srcSet: lineImage.srcSet.attribute },
  youtube: { src: youtubeImage.src, srcSet: youtubeImage.srcSet.attribute },
};
---

<ul class="header__menu">
  <li class="header__menu_item">
    <MenuIcon
      className={home.classNameHeader}
      href={home.link}
      ariaLabel={home.ariaLabel}
      ariaTitle={home.ariaTitle}
      menuIcon={home.icon}
    />
  </li>
  <li class="header__menu_item">
    <MenuIcon
      className={contact.classNameHeader}
      href={contact.link}
      ariaLabel={contact.ariaLabel}
      ariaTitle={contact.ariaTitle}
      menuIcon={contact.icon}
    />
  </li>
  <li class="header__menu_item">
    <ThemeColor />
  </li>
  <li class="header__menu_item">
    <BackgroundImage />
  </li>
  <li class="header__menu_item header__menu_item--hamburger">
    <HamburgerMenu client:visible brandIcons={brandIcons} />
  </li>
</ul>

<style is:global>
  /* 480px以下でのナビゲーション最適化 */
  @media (width <= 480px) {
    .header__menu {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      flex-wrap: nowrap;
    }

    .header__menu_item {
      flex: 0 0 auto;
    }

    .header__menu_item--hamburger {
      order: 5;
    }
  }
</style>

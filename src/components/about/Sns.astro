---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import SafeIcon from "@/components/ui/SafeIcon.astro";

interface SnsProps {
  className: string;
  href: string;
  snsIconSvg?: string;
  /** ダークモード時に差し替えるSVGアセット（公式ロゴの白版など） */
  snsIconDarkSvg?: string;
  /** ラスター画像の公式ロゴ（LINE / YouTube など）。指定時は最適化して表示し、押下時の演出を無効化する */
  snsIconImage?: ImageMetadata;
  /** ブランド名（例: "youtube"）。li に sns-icon__item--{brand} クラスを付与し、ロゴ個別の調整に使う */
  snsBrand?: string;
  snsIconName?: string;
  ariaLabel: string;
  ariaTitle: string;
  targetBlank?: string;
}

const {
  className,
  href,
  snsIconSvg,
  snsIconDarkSvg,
  snsIconImage,
  snsBrand,
  snsIconName,
  ariaLabel,
  ariaTitle,
  targetBlank,
} = Astro.props as SnsProps;

const snsIconWidth: number = 28;
const snsIconHeight: number = 28;
const isSvgAsset =
  typeof snsIconSvg === "string" &&
  snsIconSvg.trim() !== "" &&
  (snsIconSvg.endsWith(".svg") || snsIconSvg.startsWith("/") || snsIconSvg.startsWith("."));
const hasDarkVariant = isSvgAsset && typeof snsIconDarkSvg === "string" && snsIconDarkSvg.trim() !== "";
---

<li
  class:list={[
    "sns-icon__item",
    { "sns-icon__item--static": snsIconImage != null },
    snsBrand != null && `sns-icon__item--${snsBrand}`,
  ]}
>
  <a
    class={className}
    href={href}
    aria-label={ariaLabel}
    title={ariaTitle}
    {...targetBlank === "_blank" ? { target: "_blank" as const } : {}}
  >
    {
      snsIconImage != null ? (
        <Image
          src={snsIconImage}
          width={snsIconWidth}
          densities={[1, 2, 3]}
          format="png"
          alt=""
          loading="lazy"
          decoding="async"
          aria-hidden="true"
          class="sns-icon__img sns-icon__img--brand"
        />
      ) : null
    }
    {
      snsIconImage == null && isSvgAsset ? (
        <img
          src={snsIconSvg}
          width={snsIconWidth}
          height={snsIconHeight}
          alt={snsIconName ?? ""}
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          aria-hidden={snsIconName == null}
          data-sns-icon={snsIconSvg}
          class={hasDarkVariant ? "sns-icon__img sns-icon__img--light" : "sns-icon__img"}
        />
      ) : null
    }
    {
      hasDarkVariant ? (
        <img
          src={snsIconDarkSvg}
          width={snsIconWidth}
          height={snsIconHeight}
          alt=""
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          aria-hidden="true"
          class="sns-icon__img sns-icon__img--dark"
        />
      ) : null
    }
    {
      snsIconImage != null || isSvgAsset ? null : (
        <SafeIcon name={snsIconSvg} width={snsIconWidth} height={snsIconHeight} />
      )
    }
    {snsIconName != null && snsIconName.trim() !== "" && <span class="sns-icon__name">{snsIconName}</span>}
  </a>
</li>
